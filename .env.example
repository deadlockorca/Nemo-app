# Copy to .env. Use the public HTTPS URL in production.
APP_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nemo_admin
DB_USER=nemo_admin
DB_PASSWORD=
# Optional for a MySQL server on another host with a trusted CA certificate:
# DB_SSL_CA_FILE=/absolute/path/to/mysql-ca.pem

# Run npm run license:keygen, then set an absolute server-only path.
LICENSE_PRIVATE_KEY_FILE=

# Private installation storage, outside public/webroot. Keep this encryption key
# in a server secret store; back it up with the encrypted certificate files.
INSTALL_STORAGE_DIR=
INSTALL_STORAGE_KEY=
# Python 3.11+ with scripts/ios/requirements.txt installed.
IOS_SIGN_PYTHON=python3
# auto: macOS uses Apple codesign; Linux uses the pinned zsign build.
IOS_SIGN_BACKEND=auto
IOS_ZSIGN_BIN=/usr/local/bin/zsign

# Optional hourly public certificate-revocation checks and expiry alerts.
# Apply migration 010, then run npm run certificate:worker as a separate process.
CERTIFICATE_MONITOR_ENABLED=false
CERTIFICATE_ALERT_TO=
# SMTP requires TLS: implicit TLS on 465, or mandatory STARTTLS on 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
