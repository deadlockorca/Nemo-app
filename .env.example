# Copy to .env. Use the public HTTPS URL in production.
APP_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nemo_admin
DB_USER=nemo_admin
DB_PASSWORD=
# Optional for a MySQL server on another host with a trusted CA certificate:
# DB_SSL_CA_FILE=/absolute/path/to/mysql-ca.pem

# Run npm run license:keygen, then set an absolute server-only path.
LICENSE_PRIVATE_KEY_FILE=
